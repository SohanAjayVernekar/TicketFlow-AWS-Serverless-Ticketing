# Copy to .env.local and fill with your provisioned AWS values.
# Never commit .env.local.

VITE_AWS_REGION=ap-south-1
VITE_COGNITO_USER_POOL_ID=YOUR_USER_POOL_ID
VITE_COGNITO_CLIENT_ID=YOUR_APP_CLIENT_ID
VITE_COGNITO_DOMAIN=https://YOUR_COGNITO_DOMAIN.auth.ap-south-1.amazoncognito.com
VITE_API_BASE_URL=https://YOUR_API_ID.execute-api.ap-south-1.amazonaws.com
